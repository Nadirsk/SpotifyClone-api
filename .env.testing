# Testing environment.
#
# This file exists so that `--env=testing` cannot fall back to `.env`.
# Without it, `php artisan migrate:fresh --env=testing` silently loads `.env`
# and drops every table in the DEVELOPMENT database — which is exactly what
# happened once. phpunit.xml sets the same DB_DATABASE for the test suite
# itself; this file covers artisan commands run with --env=testing by hand.

APP_NAME="Music Discovery"
APP_ENV=testing
APP_KEY=base64:T4zc7KpCzMGRSaUPMNTxf0YpIHayhUThYEqr8ukk4Os=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=music_discovery_test
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

# Swap to `redis` before the production deploy (see docs/DEFERRED.md).
CACHE_STORE=array

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=aaibuzzmail@gmail.com
MAIL_PASSWORD=opwvzxulnxhiqlss
MAIL_FROM_ADDRESS=aaibuzzmail@gmail.com
MAIL_FROM_NAME="Resonance"

#--------------------------------------------------------------------------
# Frontend / CORS
#--------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

#--------------------------------------------------------------------------
# Search
#--------------------------------------------------------------------------
# `database` uses MySQL FULLTEXT. Swap to `elasticsearch` before the
# production deploy (see docs/DEFERRED.md).
SEARCH_DRIVER=database
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=music_

#--------------------------------------------------------------------------
# Cache TTLs (seconds) — per 02_SYSTEM_ARCHITECTURE section 7
#--------------------------------------------------------------------------
CACHE_TTL_SEARCH=900
CACHE_TTL_TRENDING=1800
CACHE_TTL_ARTIST=3600
CACHE_TTL_ALBUM=3600
CACHE_TTL_SONG=3600

#--------------------------------------------------------------------------
# Rate limiting — per 05_API_SPECIFICATION section 17
#--------------------------------------------------------------------------
RATE_LIMIT_GUEST=60
RATE_LIMIT_AUTH=300

#--------------------------------------------------------------------------
# Provider credentials — never commit real values
#--------------------------------------------------------------------------
SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

APPLE_MUSIC_ENABLED=false
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=

DEEZER_ENABLED=false

MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT="MusicDiscovery/1.0 ( no-reply@musicdiscovery.test )"

LASTFM_ENABLED=false
LASTFM_API_KEY=

JIOSAAVN_ENABLED=true
JIOSAAVN_BASE_URL=https://saavn.sumit.co/api

# Disabled 2026-08-07 on request — JioSaavn only for now. Re-enable by
# flipping this back to true; nothing else needs to change.
ITUNES_ENABLED=false
ITUNES_BASE_URL=https://itunes.apple.com
ITUNES_COUNTRY=IN

#--------------------------------------------------------------------------
# Google OAuth
