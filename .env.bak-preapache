# Re-enabled 2026-08-17 on request: JioSaavn is the active provider again and
# YouTube is off (see below). Nothing but this flag changed — the adapter, its
# rate limits and its base URL are as they were before 2026-08-16.
# The public instance is a shared free-tier Cloudflare Worker. When its daily
# allowance runs out it answers every endpoint with 429 + "error code: 1027"
# until 00:00 UTC, and no client-side tuning gets that back — point this at a
# self-hosted copy of the wrapper to stop depending on someone else's quota.
JIOSAAVN_ENABLED=true
# Repointed at the local wrapper 2026-08-19. It was on the shared public
# instance *and* still carrying the 20 req/s limit sized for the local one,
# which config/providers.php says must drop to ~2/s against the public Worker —
# so it was running ten times over what that instance tolerates, and was in
# fact answering 429 when the credits backfill first tried to read from it.
# Start the wrapper with:  node --conditions=production node-server.mjs
# from tools/jiosaavn-api (or run its start-local.cmd).
JIOSAAVN_BASE_URL=http://127.0.0.1:3500/api
# JIOSAAVN_BASE_URL=https://saavn.sumit.co/api   # shared free tier; needs the limits below at ~2/s
# Requests per JIOSAAVN_RATE_LIMIT_PER_SECONDS seconds; see config/providers.php.
JIOSAAVN_RATE_LIMIT_REQUESTS=20
JIOSAAVN_RATE_LIMIT_PER_SECONDS=1

