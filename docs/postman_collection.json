{
  "info": {
    "_postman_id": "8f2c1a10-4b3e-4a2a-9c1e-music-discovery-api",
    "name": "Music Discovery Platform API",
    "description": "Local backend at http://localhost:8000. Start MySQL + `php artisan serve` first (see backend/README.md). Auth requests auto-save {{token}}; list requests auto-save {{song_id}}/{{artist_id}}/{{album_id}}; Create Playlist auto-saves {{playlist_id}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000", "type": "string" },
    { "key": "api_url", "value": "{{base_url}}/api/v1", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "song_id", "value": "", "type": "string" },
    { "key": "artist_id", "value": "", "type": "string" },
    { "key": "album_id", "value": "", "type": "string" },
    { "key": "playlist_id", "value": "", "type": "string" },
    { "key": "email", "value": "demo@musicdiscovery.test", "type": "string" },
    { "key": "password", "value": "password", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/up", "host": ["{{base_url}}"], "path": ["up"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Saved token from register');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"newuser@musicdiscovery.test\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"country\": \"US\",\n  \"language\": \"en\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/register", "host": ["{{api_url}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.success && json.data && json.data.token) {",
                  "    pm.collectionVariables.set('token', json.data.token);",
                  "    console.log('Saved token from login');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/login", "host": ["{{api_url}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{api_url}}/auth/me", "host": ["{{api_url}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{api_url}}/auth/logout", "host": ["{{api_url}}"], "path": ["auth", "logout"] }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\"\n}" },
            "url": { "raw": "{{api_url}}/auth/forgot-password", "host": ["{{api_url}}"], "path": ["auth", "forgot-password"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"paste-token-from-log-or-email\",\n  \"email\": \"{{email}}\",\n  \"password\": \"newpassword123\",\n  \"password_confirmation\": \"newpassword123\"\n}"
            },
            "url": { "raw": "{{api_url}}/auth/reset-password", "host": ["{{api_url}}"], "path": ["auth", "reset-password"] }
          }
        },
        {
          "name": "Google Redirect",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{api_url}}/auth/google", "host": ["{{api_url}}"], "path": ["auth", "google"] }
          }
        }
      ]
    },
    {
      "name": "Search",
      "item": [
        {
          "name": "Global Search",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/search?q=believer",
              "host": ["{{api_url}}"],
              "path": ["search"],
              "query": [{ "key": "q", "value": "believer" }]
            }
          }
        },
        {
          "name": "Typed Search (songs)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/search?q=a&type=song&page=1&limit=20&sort=popularity",
              "host": ["{{api_url}}"],
              "path": ["search"],
              "query": [
                { "key": "q", "value": "a" },
                { "key": "type", "value": "song" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "sort", "value": "popularity" }
              ]
            }
          }
        },
        {
          "name": "Autocomplete Suggest",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_url}}/search/suggest?q=so&limit=10",
              "host": ["{{api_url}}"],
              "path": ["search", "suggest"],
              "query": [
                { "key": "q", "value": "so" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        }
      ]
    },
    {
