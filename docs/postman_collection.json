      "item": [
        {
          "name": "List Songs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.success && Array.isArray(json.data) && json.data.length) {",
                  "    pm.collectionVariables.set('song_id', json.data[0].id);",
                  "    console.log('Saved song_id: ' + json.data[0].id);",
