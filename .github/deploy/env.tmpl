APP_NAME="{{ app_name }}"
APP_ENV=production
APP_KEY="{{ app_key }}"
APP_DEBUG=false
APP_URL=https://{{ domain }}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE="{{ db_name }}"
DB_USERNAME="{{ db_user }}"
DB_PASSWORD="{{ db_password }}"

#--------------------------------------------------------------------------
# Drivers
# Redis is not provisioned on this host (see docs/DEFERRED.md #1). These stay
# on the `database` driver until Redis is installed; flipping them before then
# will break the deploy.
#--------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST="{{ mail_host }}"
MAIL_PORT=587
MAIL_USERNAME="{{ mail_username }}"
MAIL_PASSWORD="{{ mail_password }}"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="{{ mail_from_address }}"
MAIL_FROM_NAME="{{ app_name }}"

#--------------------------------------------------------------------------
# Frontend
#--------------------------------------------------------------------------
FRONTEND_URL="{{ frontend_url }}"

#--------------------------------------------------------------------------
# Search
# Elasticsearch is not provisioned (see docs/DEFERRED.md #2). Keep the
# `database` driver (MySQL FULLTEXT) until an ES node exists.
#--------------------------------------------------------------------------
SEARCH_DRIVER=database
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=music_

#--------------------------------------------------------------------------
# Cache TTLs (seconds)
#--------------------------------------------------------------------------
CACHE_TTL_SEARCH=900
CACHE_TTL_TRENDING=1800
CACHE_TTL_ARTIST=3600
CACHE_TTL_ALBUM=3600
CACHE_TTL_SONG=3600

#--------------------------------------------------------------------------
# Rate limiting
#--------------------------------------------------------------------------
RATE_LIMIT_GUEST=60
RATE_LIMIT_AUTH=300

#--------------------------------------------------------------------------
# Provider credentials — every provider ships disabled. Fill the credentials
# in the ServerPilot Secrets tab and flip *_ENABLED=true to turn one on.
#--------------------------------------------------------------------------
PROVIDER_TIMEOUT=10
PROVIDER_CONNECT_TIMEOUT=5

SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

APPLE_MUSIC_ENABLED=false
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

DEEZER_ENABLED=false

MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT="MusicDiscovery/1.0 ( no-reply@{{ domain }} )"

LASTFM_ENABLED=false
LASTFM_API_KEY=

JIOSAAVN_ENABLED=false
JIOSAAVN_BASE_URL=https://saavn.dev/api

#--------------------------------------------------------------------------
# Google OAuth
#--------------------------------------------------------------------------
GOOGLE_CLIENT_ID="{{ google_client_id }}"
GOOGLE_CLIENT_SECRET="{{ google_client_secret }}"
GOOGLE_REDIRECT_URI=https://{{ domain }}/api/v1/auth/google/callback
