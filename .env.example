#--------------------------------------------------------------------------
# Diagnostics
#--------------------------------------------------------------------------
# GET /diagnostics?key=... - a status page for checking the scheduler, the
# queue worker and Reverb are alive without server/SSH access (see
# DiagnosticsController). Same value as the local .env on purpose, so the
# link already works in production without generating a second key -
# rotate it (php artisan tinker --execute="echo Str::random(40);") only if
# this one is ever shared somewhere it shouldn't be.
DIAGNOSTICS_KEY=jRFzFMB9VT4QREtWK1OlwxEzarVupwVk3BCvBafE

#--------------------------------------------------------------------------
# Providers - shared
#--------------------------------------------------------------------------
# Seconds. Every other knob (retries, circuit breaker, dedupe tolerance) is a
# constant in config/providers.php, deliberately not an environment variable.
PROVIDER_TIMEOUT=10
PROVIDER_CONNECT_TIMEOUT=5

#--------------------------------------------------------------------------
# JioSaavn - the live catalog source
#--------------------------------------------------------------------------

JIOSAAVN_ENABLED=true
JIOSAAVN_BASE_URL=http://127.0.0.1:3500/api
JIOSAAVN_RATE_LIMIT_REQUESTS=20
JIOSAAVN_RATE_LIMIT_PER_SECONDS=1
JIOSAAVN_COOLDOWN_MS=5000
JIOSAAVN_COOLDOWN_MAX_MS=120000
JIOSAAVN_MAX_WAIT_MS=15000

#--------------------------------------------------------------------------
# Catalog crawl - the discovery half of the sync engine
#--------------------------------------------------------------------------
# These match the defaults in config/providers.php, where each one is
# documented. Override only with a reason: they are tuned against JioSaavn's
# real page sizes.
#
# CATALOG_CRAWL_ENABLED is the master switch for the *background* discovery
# sweep (CrawlFrontierJob/DiscoverNewReleasesJob in routes/console.php) — off
# by default so a fresh checkout only ever syncs what someone actually
# searches for, rather than self-feeding (CRAWL_EXPAND_ARTISTS) its way
# through JioSaavn's entire catalog unattended. Set to true once a full local
# or production catalog is actually wanted, not merely on-demand.
CATALOG_CRAWL_ENABLED=false
CRAWL_BATCH_SIZE=25
CRAWL_LEASE_SECONDS=1800
CRAWL_PAGES_PER_VISIT=40
CRAWL_MAX_ATTEMPTS=5
CRAWL_REVISIT_AFTER_HOURS=72
CRAWL_NEW_RELEASE_CHECK_HOURS=6
CRAWL_NEW_RELEASE_BATCH=200
CRAWL_EXPAND_ARTISTS=true
CRAWL_EXPAND_SUGGESTIONS=false
CRAWL_SUGGESTION_LIMIT=20
CRAWL_MIN_SEED_TERM_LENGTH=3
CRAWL_SEARCH_RESULT_CAP=5000
CRAWL_MAX_PENDING=5000000

