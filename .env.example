APP_NAME="Music Discovery"
APP_ENV=production
# Never `true` in production: Laravel's debug page prints the full environment,
# including every credential below it.
APP_DEBUG=false
# On an install that already has data, do NOT run `key:generate` - everything
# encrypted with the old key (OTP payloads, Sanctum-adjacent encrypted columns)
# stops being readable.
APP_KEY=base64:T4zc7KpCzMGRSaUPMNTxf0YpIHayhUThYEqr8ukk4Os=
APP_URL=https://api.ms.aaibuzz.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

#--------------------------------------------------------------------------
# Logging
#--------------------------------------------------------------------------
# `daily` gives the automatic rotation 10_DEPLOYMENT_DEVOPS section 14 asks
# for. Under Docker, set LOG_STACK=stderr instead and let the container log
# driver collect it.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# `debug` in production writes every query and provider payload to disk.
LOG_LEVEL=warning

# Optional: mirror errors into Slack (10_DEPLOYMENT_DEVOPS section 13).
# Add `slack` to LOG_STACK to activate it.
LOG_SLACK_WEBHOOK_URL=

#--------------------------------------------------------------------------
# Database - MySQL 8
#--------------------------------------------------------------------------
# Under Docker Compose, DB_HOST is the service name (e.g. `mysql`).
#
# Server prerequisite: set `innodb_ft_min_token_size=1` in my.cnf and restart
# MySQL BEFORE running migrations. The default of 3 silently drops the short
# words this catalog is full of, which breaks FULLTEXT search on them. The
# value is read when an index is built, so changing it later means rebuilding
# every FULLTEXT index.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=music_discovery
DB_USERNAME=team
DB_PASSWORD='AaibuzzTeam#123'
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Path to the CA bundle when MySQL is a managed instance reached over TLS.
MYSQL_ATTR_SSL_CA=

#--------------------------------------------------------------------------
# Session
#--------------------------------------------------------------------------
# The API itself is stateless (Sanctum bearer tokens - see bootstrap/app.php).
# Sessions exist only to carry the Google OAuth state between the redirect and
# the callback, which is exactly why the store has to be shared across app
# containers: a callback landing on a different container otherwise fails.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

#--------------------------------------------------------------------------
# Cache, queue, filesystem
#--------------------------------------------------------------------------
# `reverb` - Listen Together's real-time sync (playback, membership, queue
# events) is broadcast over it. See the Reverb section further down for the
# app credentials and the server process this actually requires.
BROADCAST_CONNECTION=reverb

# Avatars are pinned to the `public` disk (ProfileService::AVATAR_DISK), so
# storage/app/public must be a shared volume if more than one app container
# runs. Changing this value alone will NOT move them.
FILESYSTEM_DISK=public

# Redis for both. Requires the phpredis extension, or `composer require
# predis/predis` plus REDIS_CLIENT=predis - see docs/DEFERRED.md section 1.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
CACHE_PREFIX=music_discovery_cache_

# How long the queue waits before deciding a reserved job died and handing it to
# another worker. It MUST exceed the longest job timeout - CrawlFrontierJob is
# `$timeout = 1800` - so this is 1800 + 60. Laravel's stock 90 is a live bug on
# this project, not a tuning preference: at 90s a healthy ten-minute crawl is
# re-reserved every 90 seconds while it is still running, `attempts` climbs, and
# a job that never failed ends up in failed_jobs. config/queue.php already
# carries this reasoning in full on the `database` connection - but its `redis`
# default is still 90, and `redis` is the connection this project runs.
REDIS_QUEUE_RETRY_AFTER=1860

#--------------------------------------------------------------------------
# Server processes - Supervisor + cron
#--------------------------------------------------------------------------
# PHP-FPM on its own serves the HTTP API and nothing else. Three more processes
# have to be up, or the catalog never grows:
#
#   1. Queue worker (Supervisor, vars below)
#        php artisan queue:work redis --queue=sync,default,notifications \
#          --tries=3 --timeout=1800 --max-time=3600
#
#   2. Scheduler (system cron, one line, every minute)
#        * * * * * cd /var/www/music-streaming/backend \
#          && php artisan schedule:run >> /dev/null 2>&1
#
#   3. JioSaavn wrapper (its own systemd unit - it is Node, not PHP)
#        tools/jiosaavn-api, bound to 127.0.0.1:3500, started with
#        `node --conditions=production dist/server.js`. Never expose it through
#        Nginx. JIOSAAVN_BASE_URL below points at it. See README.md.
#
# The scheduler and the worker are not alternatives. routes/console.php only
# *dispatches* its eight jobs, so cron without a worker queues work nobody
# runs, and a worker without cron idles after the first manual crawl.

# CONF_NAME becomes the Supervisor program name, so it has to identify this app
# on a box that may host others - `via-*` belongs to a different project. The
# name below matches the deploy path, /var/www/music-streaming.

# Reverb (websockets) - Listen Together's real-time layer. laravel/reverb IS in
# composer.json, config/broadcasting.php and config/reverb.php are both
# published, and three events actually broadcast over it:
# app/Events/Listening/RoomPlaybackUpdated.php, RoomMembershipChanged.php and
# RoomQueueUpdated.php (all ShouldBroadcastNow - not queued, so a slow queue
# worker can never delay a "play" reaching a room). This must be `true`, and a
# fourth Supervisor program is required to run it - see the credentials section
# further down for what `php artisan reverb:start` needs.
SUPERVISOR_REVERB_ENABLED=true
SUPERVISOR_REVERB_CONF_NAME=music-streaming-reverb
SUPERVISOR_REVERB_USER=www-data
# Always 1, not a scale knob like the queue worker's NUMPROCS: Reverb holds
# every open connection's state in its own process memory, so a second
# instance would not share those connections - it would just be a separate,
# empty room server half your listeners never reach. Horizontal scaling needs
# REVERB_SCALING_ENABLED (below) fanning state through Redis instead of more
# copies of this program.
#
#   php artisan reverb:start
#
# No --host/--port flags: it reads REVERB_SERVER_HOST/REVERB_SERVER_PORT
# (below) from the environment already, and hardcoding them here would only
# create a second place to forget to update.

# Queue worker. Must be true in production: the crawl, every provider sync and
# the welcome notification are all queued jobs. This is the process that builds
# the catalog.
SUPERVISOR_QUEUE_ENABLED=true
SUPERVISOR_QUEUE_CONF_NAME=music-streaming-queue
# Mostly a floor. Every job in app/Jobs sets its own `$tries` (5, or 3 on
# DiscoverNewReleasesJob) and a job property overrides the worker flag; this
# value only applies to jobs that declare none.
SUPERVISOR_QUEUE_TRIES=3
SUPERVISOR_QUEUE_USER=www-data
# One worker keeps the frontier draining. The provider throttle is held in the
# shared cache (AbstractProviderAdapter::reserveSlot), so extra workers split
# the same JioSaavn allowance instead of multiplying throughput - raise this
# only if `php artisan queue:monitor sync` shows a standing backlog.
SUPERVISOR_QUEUE_NUMPROCS=1
#
# Then read the generated program's command line. A stock template emits a bare
# `queue:work`, and all three defaults are wrong for this project:
#
#   --queue=sync,default,notifications
#       Queue names come from the jobs themselves, not from config: `sync`
#       (CrawlFrontierJob, DiscoverNewReleasesJob, LazySyncSearchJob, all four
#       Sync*Job), `default` (RefreshTrendingJob, CleanupJob) and
#       `notifications` (SendWelcomeNotification). Order is priority. Omit a
#       name and that work sits untouched forever - drop `notifications` and
#       every new signup silently never gets its welcome mail.
#
#   --timeout=1800
#       Matches CrawlFrontierJob's own `$timeout` and CRAWL_LEASE_SECONDS below.
#       The 60s default kills a prolific artist mid-discography - Arijit Singh
#       is ~4,580 songs across 458 sequential pages. Keep this below
#       REDIS_QUEUE_RETRY_AFTER above, or the queue re-reserves a job that is
#       still running.
#
#   --max-time=3600
#       Recycles the worker hourly, so a long-lived PHP process cannot leak its
#       way to the OOM killer. Supervisor restarts it; in-flight work is not
#       lost because the worker exits between jobs.
#
# If your template reads these from the environment, uncomment them; otherwise
# put the flags in the .conf directly.
#SUPERVISOR_QUEUE_QUEUE=sync,default,notifications
#SUPERVISOR_QUEUE_TIMEOUT=1800
#SUPERVISOR_QUEUE_MAX_TIME=3600

