APP_NAME="Music Discovery"
APP_ENV=production
# Never `true` in production: Laravel's debug page prints the full environment,
# including every credential below it.
APP_DEBUG=false
# On an install that already has data, do NOT run `key:generate` - everything
# encrypted with the old key (OTP payloads, Sanctum-adjacent encrypted columns)
# stops being readable.
APP_KEY=base64:T4zc7KpCzMGRSaUPMNTxf0YpIHayhUThYEqr8ukk4Os=
APP_URL=https://api.ms.aaibuzz.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

#--------------------------------------------------------------------------
# Logging
#--------------------------------------------------------------------------
# `daily` gives the automatic rotation 10_DEPLOYMENT_DEVOPS section 14 asks
# for. Under Docker, set LOG_STACK=stderr instead and let the container log
# driver collect it.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
# `debug` in production writes every query and provider payload to disk.
LOG_LEVEL=warning

# Optional: mirror errors into Slack (10_DEPLOYMENT_DEVOPS section 13).
# Add `slack` to LOG_STACK to activate it.
LOG_SLACK_WEBHOOK_URL=

#--------------------------------------------------------------------------
# Database - MySQL 8
#--------------------------------------------------------------------------
# Under Docker Compose, DB_HOST is the service name (e.g. `mysql`).
#
# Server prerequisite: set `innodb_ft_min_token_size=1` in my.cnf and restart
# MySQL BEFORE running migrations. The default of 3 silently drops the short
# words this catalog is full of, which breaks FULLTEXT search on them. The
# value is read when an index is built, so changing it later means rebuilding
# every FULLTEXT index.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=music_discovery
DB_USERNAME=team
DB_PASSWORD='AaibuzzTeam#123'
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
# Path to the CA bundle when MySQL is a managed instance reached over TLS.
MYSQL_ATTR_SSL_CA=

#--------------------------------------------------------------------------
# Session
#--------------------------------------------------------------------------
# The API itself is stateless (Sanctum bearer tokens - see bootstrap/app.php).
# Sessions exist only to carry the Google OAuth state between the redirect and
# the callback, which is exactly why the store has to be shared across app
# containers: a callback landing on a different container otherwise fails.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

#--------------------------------------------------------------------------
# Cache, queue, filesystem
#--------------------------------------------------------------------------
BROADCAST_CONNECTION=log

# Avatars are pinned to the `public` disk (ProfileService::AVATAR_DISK), so
# storage/app/public must be a shared volume if more than one app container
# runs. Changing this value alone will NOT move them.
FILESYSTEM_DISK=public

# Redis for both. Requires the phpredis extension, or `composer require
# predis/predis` plus REDIS_CLIENT=predis - see docs/DEFERRED.md section 1.
CACHE_STORE=redis
QUEUE_CONNECTION=redis
CACHE_PREFIX=music_discovery_cache_

# How long the queue waits before deciding a reserved job died and handing it to
# another worker. It MUST exceed the longest job timeout - CrawlFrontierJob is
# `$timeout = 1800` - so this is 1800 + 60. Laravel's stock 90 is a live bug on
# this project, not a tuning preference: at 90s a healthy ten-minute crawl is
# re-reserved every 90 seconds while it is still running, `attempts` climbs, and
# a job that never failed ends up in failed_jobs. config/queue.php already
# carries this reasoning in full on the `database` connection - but its `redis`
# default is still 90, and `redis` is the connection this project runs.
REDIS_QUEUE_RETRY_AFTER=1860

#--------------------------------------------------------------------------
# Server processes - Supervisor + cron
#--------------------------------------------------------------------------
# PHP-FPM on its own serves the HTTP API and nothing else. Three more processes
# have to be up, or the catalog never grows:
#
#   1. Queue worker (Supervisor, vars below)
#        php artisan queue:work redis --queue=sync,default,notifications \
#          --tries=3 --timeout=1800 --max-time=3600
#
#   2. Scheduler (system cron, one line, every minute)
#        * * * * * cd /var/www/music-streaming/backend \
#          && php artisan schedule:run >> /dev/null 2>&1
#
#   3. JioSaavn wrapper (its own systemd unit - it is Node, not PHP)
#        tools/jiosaavn-api, bound to 127.0.0.1:3500, started with
#        `node --conditions=production dist/server.js`. Never expose it through
#        Nginx. JIOSAAVN_BASE_URL below points at it. See README.md.
#
# The scheduler and the worker are not alternatives. routes/console.php only
# *dispatches* its eight jobs, so cron without a worker queues work nobody
# runs, and a worker without cron idles after the first manual crawl.

# CONF_NAME becomes the Supervisor program name, so it has to identify this app
# on a box that may host others - `via-*` belongs to a different project. The
# name below matches the deploy path, /var/www/music-streaming.

# Reverb (websockets). This project has no realtime layer at all: laravel/reverb
# is not in composer.json, config/broadcasting.php is not published, and nothing
# in app/ or routes/ broadcasts - no ShouldBroadcast event, no broadcastOn(), no
# Broadcast:: call. So the only Reverb setting kept here is the off-switch, to
# stop a deploy template from ever starting a program whose binary is absent.
# The rest (conf name, host, port, user, numprocs) would only matter to a
# process that cannot run; add them back with the package, not before.
SUPERVISOR_REVERB_ENABLED=false

# Queue worker. Must be true in production: the crawl, every provider sync and
# the welcome notification are all queued jobs. This is the process that builds
# the catalog.
SUPERVISOR_QUEUE_ENABLED=true
SUPERVISOR_QUEUE_CONF_NAME=music-streaming-queue
# Mostly a floor. Every job in app/Jobs sets its own `$tries` (5, or 3 on
# DiscoverNewReleasesJob) and a job property overrides the worker flag; this
# value only applies to jobs that declare none.
SUPERVISOR_QUEUE_TRIES=3
SUPERVISOR_QUEUE_USER=www-data
# One worker keeps the frontier draining. The provider throttle is held in the
# shared cache (AbstractProviderAdapter::reserveSlot), so extra workers split
# the same JioSaavn allowance instead of multiplying throughput - raise this
# only if `php artisan queue:monitor sync` shows a standing backlog.
SUPERVISOR_QUEUE_NUMPROCS=1
#
# Then read the generated program's command line. A stock template emits a bare
# `queue:work`, and all three defaults are wrong for this project:
#
#   --queue=sync,default,notifications
#       Queue names come from the jobs themselves, not from config: `sync`
#       (CrawlFrontierJob, DiscoverNewReleasesJob, LazySyncSearchJob, all four
#       Sync*Job), `default` (RefreshTrendingJob, CleanupJob) and
#       `notifications` (SendWelcomeNotification). Order is priority. Omit a
#       name and that work sits untouched forever - drop `notifications` and
#       every new signup silently never gets its welcome mail.
#
#   --timeout=1800
#       Matches CrawlFrontierJob's own `$timeout` and CRAWL_LEASE_SECONDS below.
#       The 60s default kills a prolific artist mid-discography - Arijit Singh
#       is ~4,580 songs across 458 sequential pages. Keep this below
#       REDIS_QUEUE_RETRY_AFTER above, or the queue re-reserves a job that is
#       still running.
#
#   --max-time=3600
#       Recycles the worker hourly, so a long-lived PHP process cannot leak its
#       way to the OOM killer. Supervisor restarts it; in-flight work is not
#       lost because the worker exits between jobs.
#
# If your template reads these from the environment, uncomment them; otherwise
# put the flags in the .conf directly.
#SUPERVISOR_QUEUE_QUEUE=sync,default,notifications
#SUPERVISOR_QUEUE_TIMEOUT=1800
#SUPERVISOR_QUEUE_MAX_TIME=3600

#--------------------------------------------------------------------------
# Redis
#--------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=null
# Mandatory in production: an unauthenticated Redis holds sessions and queues.
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_DB=1

#--------------------------------------------------------------------------
# Mail
#--------------------------------------------------------------------------
# `smtp` is STARTTLS on 587. Use `smtps` with MAIL_PORT=465 for implicit TLS.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=aaibuzzmail@gmail.com
MAIL_PASSWORD=opwvzxulnxhiqlss
MAIL_FROM_ADDRESS=aaibuzzmail@gmail.com
MAIL_FROM_NAME="Music Discovery"

#--------------------------------------------------------------------------
# Frontend
#--------------------------------------------------------------------------
# The Next.js origin. This is the only entry in config/cors.php's allow-list,
# so a mismatch blocks every browser call the frontend makes for auth,
# favorites, history, playlists and profile. No trailing slash.
FRONTEND_URL=https://ms.aaibuzz.com

#--------------------------------------------------------------------------
# Search
#--------------------------------------------------------------------------
# Stays `database` (MySQL FULLTEXT). `elasticsearch` is the documented target
# but ElasticsearchSearchEngine is NOT implemented yet: SearchServiceProvider
# registers `database` only and throws at boot on anything else, so flipping
# this takes the whole API down. See docs/DEFERRED.md section 2.
SEARCH_DRIVER=database

# Read only once the Elasticsearch driver exists.
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=music_

#--------------------------------------------------------------------------
# Cache TTLs (seconds) - per 02_SYSTEM_ARCHITECTURE section 7
#--------------------------------------------------------------------------
CACHE_TTL_SEARCH=900
CACHE_TTL_TRENDING=1800
CACHE_TTL_ARTIST=3600
CACHE_TTL_ALBUM=3600
CACHE_TTL_SONG=3600
CACHE_TTL_RECOMMENDATIONS=1800

#--------------------------------------------------------------------------
# Rate limiting (requests per minute) - per 05_API_SPECIFICATION section 17
#--------------------------------------------------------------------------
RATE_LIMIT_GUEST=60
RATE_LIMIT_AUTH=300

#--------------------------------------------------------------------------
# Providers - shared
#--------------------------------------------------------------------------
# Seconds. Every other knob (retries, circuit breaker, dedupe tolerance) is a
# constant in config/providers.php, deliberately not an environment variable.
PROVIDER_TIMEOUT=10
PROVIDER_CONNECT_TIMEOUT=5

#--------------------------------------------------------------------------
# JioSaavn - the live catalog source
#--------------------------------------------------------------------------
# JioSaavn publishes no official API, so this talks to the self-hosted
# community wrapper in tools/jiosaavn-api. Deploy it alongside the API as its
# own service and point JIOSAAVN_BASE_URL at it.
#
# Do NOT point this at the shared public instance (saavn.sumit.co) in
# production: it is a free-tier Worker whose daily allowance is pooled across
# everyone using it, and a catalog crawl exhausts that within minutes - after
# which every endpoint answers 429 until 00:00 UTC. If you must, drop
# JIOSAAVN_RATE_LIMIT_REQUESTS to 2 first.
JIOSAAVN_ENABLED=true
# The self-hosted wrapper, same server, loopback only. Point this at the public
# instance and the first crawl exhausts its shared daily allowance in minutes,
# after which every endpoint answers 429 until 00:00 UTC.
JIOSAAVN_BASE_URL=http://127.0.0.1:3500/api
# Sized for the local wrapper, where there is no shared quota to protect.
JIOSAAVN_RATE_LIMIT_REQUESTS=20
JIOSAAVN_RATE_LIMIT_PER_SECONDS=1
# How long one 429 parks the provider, doubling per consecutive 429.
JIOSAAVN_COOLDOWN_MS=5000
JIOSAAVN_COOLDOWN_MAX_MS=120000
# Longest a crawl worker waits for its rate-limit slot before shedding a call.
JIOSAAVN_MAX_WAIT_MS=15000

#--------------------------------------------------------------------------
# Catalog crawl - the discovery half of the sync engine
#--------------------------------------------------------------------------
# These match the defaults in config/providers.php, where each one is
# documented. Override only with a reason: they are tuned against JioSaavn's
# real page sizes.
CRAWL_BATCH_SIZE=25
CRAWL_LEASE_SECONDS=1800
CRAWL_PAGES_PER_VISIT=40
CRAWL_MAX_ATTEMPTS=5
CRAWL_REVISIT_AFTER_HOURS=72
CRAWL_NEW_RELEASE_CHECK_HOURS=6
CRAWL_NEW_RELEASE_BATCH=200
CRAWL_EXPAND_ARTISTS=true
# Leave off until the structural crawl has drained: every song yields ~20 more
# seeds, which turns a converging crawl into one that never finishes.
CRAWL_EXPAND_SUGGESTIONS=false
CRAWL_SUGGESTION_LIMIT=20
CRAWL_MIN_SEED_TERM_LENGTH=3
CRAWL_SEARCH_RESULT_CAP=5000
# Hard ceiling on pending frontier rows, so an unbounded closure cannot fill
# the disk unattended.
CRAWL_MAX_PENDING=5000000

#--------------------------------------------------------------------------
# Providers - not in use
#--------------------------------------------------------------------------
# All disabled. An adapter only touches the network when its flag is true AND
# its credentials are present. To enable one: fill its credentials, set
# *_ENABLED=true, enable its row in the `providers` table, then run
# `php artisan catalog:bootstrap`. See docs/DEFERRED.md section 4.

# Apple's free keyless Search API. Off: it publishes no popularity score and
# only 30-second previews, and its results duplicate JioSaavn's.
ITUNES_ENABLED=false
ITUNES_BASE_URL=https://itunes.apple.com
ITUNES_COUNTRY=IN

SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

# The paid Apple Music catalog API - distinct from ITUNES_* above.
# APPLE_MUSIC_PRIVATE_KEY is the .p8 contents; literal \n escapes are accepted.
APPLE_MUSIC_ENABLED=false
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

DEEZER_ENABLED=false

# MusicBrainz blocks clients that do not identify themselves with a contactable
# User-Agent, so it is treated as a credential: no value, no outbound call.
MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT="MusicDiscovery/1.0 ( no-reply@your-domain.com )"

LASTFM_ENABLED=false
LASTFM_API_KEY=

#--------------------------------------------------------------------------
# Google OAuth
#--------------------------------------------------------------------------
# The redirect URI must be registered verbatim in the Google Cloud console,
# and APP_URL must already be the production HTTPS origin for it to expand
# correctly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"

#--------------------------------------------------------------------------
# SMS OTP (phone sign-up) - India-only (DLT)
#--------------------------------------------------------------------------
SMS_ENDPOINT=http://textsms.thetechmore.in/http-tokenkeyapi.php
SMS_AUTH_KEY=383341414942555a5a3130301739883077
SMS_SENDER_ID=AAIBUZ
SMS_ROUTE=1
SMS_TEMPLATE_ID=1607100000000340748
OTP_TTL_MINUTES=5

# Fixed-OTP test bypass. Blank on purpose - blank disables it entirely
# (OtpService::isBypassPhone). A value here hands anyone who learns that number
# a login code that never rotates, which is a production backdoor. Local dev
# only: the number was 9326431979 / 123456.
#
# The browser E2E suite signs in as this number, via the non-production-only
# POST /testing/verify-bypass-phone fixture rather than by sending an SMS -
# OtpService::send() bills a real credit even for the bypass number and is
# capped at 3 per 5 minutes. Set OTP_BYPASS_PHONE for the suite to use the
# phone path; without it the suite falls back to demo@musicdiscovery.test and
# needs UserSeeder. See frontend/tests/e2e/helpers.ts.
OTP_BYPASS_PHONE=
OTP_BYPASS_OTP=

