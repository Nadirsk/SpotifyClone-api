#--------------------------------------------------------------------------
VULTR_ACCESS_KEY_ID=755K176ANQ8SGKO1M4RV
VULTR_SECRET_ACCESS_KEY=iwNu8KsOTGjRvoaGcjGlKUooqIE5Rdm410CR1BsE
VULTR_DEFAULT_REGION=blr1
VULTR_BUCKET=space-1
