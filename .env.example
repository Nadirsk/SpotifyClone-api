APP_NAME="Music Discovery"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=music_discovery
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

# Swap to `redis` before the production deploy (see docs/DEFERRED.md).
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@musicdiscovery.test"
MAIL_FROM_NAME="${APP_NAME}"

#--------------------------------------------------------------------------
# Frontend
#--------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

#--------------------------------------------------------------------------
# Search
#--------------------------------------------------------------------------
# `database` uses MySQL FULLTEXT. Swap to `elasticsearch` before the
# production deploy (see docs/DEFERRED.md).
SEARCH_DRIVER=database
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=music_

#--------------------------------------------------------------------------
# Cache TTLs (seconds) - per 02_SYSTEM_ARCHITECTURE section 7
#--------------------------------------------------------------------------
CACHE_TTL_SEARCH=900
CACHE_TTL_TRENDING=1800
CACHE_TTL_ARTIST=3600
CACHE_TTL_ALBUM=3600
CACHE_TTL_SONG=3600

#--------------------------------------------------------------------------
# Rate limiting - per 05_API_SPECIFICATION section 17
#--------------------------------------------------------------------------
RATE_LIMIT_GUEST=60
RATE_LIMIT_AUTH=300

#--------------------------------------------------------------------------
# Provider credentials - never commit real values
#--------------------------------------------------------------------------
PROVIDER_TIMEOUT=10
PROVIDER_CONNECT_TIMEOUT=5

SPOTIFY_ENABLED=false
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_MARKET=US

APPLE_MUSIC_ENABLED=false
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=us

DEEZER_ENABLED=false

MUSICBRAINZ_ENABLED=false
MUSICBRAINZ_USER_AGENT="MusicDiscovery/1.0 ( no-reply@musicdiscovery.test )"

LASTFM_ENABLED=false
LASTFM_API_KEY=

# No official public API; base_url points at a community-maintained wrapper by
# default. Point it at a self-hosted mirror for anything beyond light dev use.
JIOSAAVN_ENABLED=false
JIOSAAVN_BASE_URL=https://saavn.dev/api

#--------------------------------------------------------------------------
# Google OAuth
#--------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/auth/google/callback"
